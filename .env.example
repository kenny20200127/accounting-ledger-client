# Leave both unset for local development: requests stay same-origin and Vite proxies /api
# to the API below. Set VITE_API_URL only when the built client is served from another host.

# API origin, no trailing slash, no /api/v1 suffix. Requires the API to send CORS headers.
# VITE_API_URL=https://api.example.com

# Dev-server proxy target for /api. Defaults to http://localhost:3000.
# VITE_API_PROXY_TARGET=http://localhost:3000

# Product name shown after the company name in every browser tab, and the default tab
# icon before a company logo is uploaded. Defaults: Northstar, /favicon.png
# VITE_APP_NAME=Northstar
# VITE_APP_ICON=/favicon.png
