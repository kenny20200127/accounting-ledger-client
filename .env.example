# Leave both unset for local development: requests stay same-origin and Vite proxies /api
# to the API below. Production builds already default to the deployed API (PRODUCTION_API_URL
# in vite.config.ts); set VITE_API_URL only to build against a different origin.

# API origin, no trailing slash, no /api/v1 suffix. Requires the API to send CORS headers.
# VITE_API_URL=https://accounting-ledger-client-api.onrender.com

# Dev-server proxy target for /api. Defaults to the deployed API; uncomment to use a local API.
# VITE_API_PROXY_TARGET=http://localhost:3000

# Product name shown after the company name in every browser tab, and the default tab
# icon before a company logo is uploaded. Defaults: HICAD, /favicon.png
# VITE_APP_NAME=HICAD
# VITE_APP_ICON=/favicon.png
